# Copy this file to sync_snapshots.conf and update the values for your account.
# Environment variables passed to sync_snapshots.sh take precedence.

REMOTE_HOST="${REMOTE_HOST:-cmslpc-el9.fnal.gov}"
REMOTE_DIR="${REMOTE_DIR:-/path/on/lpc/to/DisappTrks_v2/analysis_dashboard}"
REMOTE_COLLECT="${REMOTE_COLLECT:-1}"

DASHBOARD_ENSURE_PROXY="${DASHBOARD_ENSURE_PROXY:-0}"
DASHBOARD_PROXY_MIN_VALID="${DASHBOARD_PROXY_MIN_VALID:-4:00}"
DASHBOARD_PROXY_VALID="${DASHBOARD_PROXY_VALID:-192:00}"
DASHBOARD_CONDOR_HISTORY_LIMIT="${DASHBOARD_CONDOR_HISTORY_LIMIT:-200}"
DASHBOARD_CONDOR_SCHEDDS="${DASHBOARD_CONDOR_SCHEDDS:-lpcschedd4.fnal.gov,lpcschedd5.fnal.gov,lpcschedd6.fnal.gov}"

DASHBOARD_CRAB_TASK_GLOBS="${DASHBOARD_CRAB_TASK_GLOBS:-}"
DASHBOARD_CRAB_WORKERS="${DASHBOARD_CRAB_WORKERS:-8}"
DASHBOARD_CRAB_TIMEOUT_SEC="${DASHBOARD_CRAB_TIMEOUT_SEC:-120}"
DASHBOARD_OUTPUT_MAPPING_SCRIPTS="${DASHBOARD_OUTPUT_MAPPING_SCRIPTS:-}"
DASHBOARD_DERIVED_OUTPUT_PREFIXES="${DASHBOARD_DERIVED_OUTPUT_PREFIXES:-JetMET=/store/group/lpcdisapptrks/ntuplizer}"

DASHBOARD_EOS_ENDPOINT="${DASHBOARD_EOS_ENDPOINT:-root://cmseosmgm01.fnal.gov}"
DASHBOARD_EOS_ROOTS="${DASHBOARD_EOS_ROOTS:-/store/group/lpcdisapptrks/ntuplizer,/store/group/lpcdisapptrks/nano/dev,/store/group/lpcdisapptrks/nano/prod,/store/group/lpcdisapptrks/nano/sample}"
