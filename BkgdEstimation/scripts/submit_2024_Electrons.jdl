universe = vanilla
executable = run_job.sh

arguments = $(ProcId) 2024

output = logs/2024/job_Electrons_2024_Pveto_27May_$(ProcId).out
error  = logs/2024/job_Electrons_2024_Pveto_27May_$(ProcId).err
log    = logs/2024/job_Electrons_2024_Pveto_27May_$(ProcId).log

request_cpus = 1
request_memory = 4GB
request_disk = 2GB

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_output_files = analysis_output
transfer_input_files = ElectronBackground_table15_pveto_json_pairfix.py,filelists,helper_functions.py,python_env

queue $(queue)