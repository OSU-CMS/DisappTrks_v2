universe = vanilla
executable = run_electron_job.sh

electron_fiducial_map =
muon_fiducial_map =
fiducial_threshold = 2.0
min_fiducial_delta_r = 0.05
n_jobs = 1
extra_transfer_input_files =

arguments = $(ProcId) $(dataset)
environment = "ELECTRON_FIDUCIAL_MAP=$(electron_fiducial_map) MUON_FIDUCIAL_MAP=$(muon_fiducial_map) FIDUCIAL_THRESHOLD=$(fiducial_threshold) MIN_FIDUCIAL_DELTA_R=$(min_fiducial_delta_r)"

output = logs/$(dataset)/job_Electrons_$(dataset)_Pveto_$(ProcId).out
error  = logs/$(dataset)/job_Electrons_$(dataset)_Pveto_$(ProcId).err
log    = logs/$(dataset)/job_Electrons_$(dataset)_Pveto_$(ProcId).log

request_cpus = 1
request_memory = 4GB
request_disk = 2GB

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_output_files = analysis_output_electron
transfer_input_files = ElectronBackground_v2_table15_pveto_json_pairfix_taujet.py,fiducial_map_tools.py,runtime_warnings.py,filelists,python_env$(extra_transfer_input_files)

queue $(n_jobs)
