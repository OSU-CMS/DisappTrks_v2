universe = vanilla
executable = run_job.sh

electron_fiducial_map =
muon_fiducial_map =
fiducial_threshold = 2.0
min_fiducial_delta_r = 0.05

arguments = $(ProcId)
environment = "ELECTRON_FIDUCIAL_MAP=$(electron_fiducial_map) MUON_FIDUCIAL_MAP=$(muon_fiducial_map) FIDUCIAL_THRESHOLD=$(fiducial_threshold) MIN_FIDUCIAL_DELTA_R=$(min_fiducial_delta_r)"

output = logs/job_Muons_2023D_Pveto_NewCode_$(ProcId).out
error  = logs/job_Muons_2023D_Pveto_NewCode_$(ProcId).err
log    = logs/job_Muons_2023D_Pveto_NewCode_$(ProcId).log

request_cpus = 1
request_memory = 4GB
request_disk = 2GB

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = MuonBackground_v2_table16_pveto_json_pairfix_taujet.py, fiducial_map_tools.py, runtime_warnings.py, filelist_2023D_Muons.txt, helper_functions.py, python_env

queue 24
