universe = vanilla
executable = run_fiducial_map_job.sh

arguments = $(ProcId) $(dataset) $(flavor) $(tag)
environment = "FILES_PER_JOB=$(files_per_job) FIDUCIAL_LAYERS=$(layers)"

output = logs/$(dataset)/fiducial_$(flavor)_$(tag)_$(ProcId).out
error  = logs/$(dataset)/fiducial_$(flavor)_$(tag)_$(ProcId).err
log    = logs/$(dataset)/fiducial_$(flavor)_$(tag)_$(ProcId).log

request_cpus = 1
request_memory = 4GB
request_disk = 2GB

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_output_files = analysis_output_fiducial
transfer_input_files = make_fiducial_maps_v2.py,fiducial_map_tools.py,runtime_warnings.py,ElectronBackground_v2_table15_pveto_json_pairfix_taujet.py,MuonBackground_v2_table16_pveto_json_pairfix_taujet.py,filelists,python_env

queue $(queue)
